# ============================================================
# 환경 변수 예시 파일
#
# 이 파일을 실제 키를 채워서 쓰는 것이 아니라,
# .env.local 이나 Vercel 대시보드에 어떤 키를 넣어야 하는지 설명하는 용도입니다.
#
# ★★★ 매우 중요 ★★★
#  실제 키를 이 파일에 직접 적어 커밋하면 키가 공개 저장소에 유출됩니다.
#  아래 값을 그대로 복사해서 .env.local (이름 앞에 점이 붙은 파일)을 만들고,
#  그 파일은 .gitignore 에 포함시켜 절대 커밋하지 마세요.
#
#  .env.local 만들기:
#      cp .env.example .env.local
#      그 다음 .env.local 안에 실제 키를 적습니다.
#
# --------------------------------------------------------
# AI 기능에 필요합니다. 이 키가 없어도 사이트는 정상 동작하며,
# AI 대신 키워드 매칭 점수만 보여줍니다.
#
# 기본 provider 는 Google Gemini 입니다.
# 키 발급: https://aistudio.google.com/apikey
# --------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=여기에_실제_키를_입력하세요

# 사용할 모델
# gemini-3.8-flash      : 정확도 우선 (기본값, 신규 프로젝트 접근 가능)
# gemini-3.5-flash-lite : 더 빠르고 저렴. 비용이 중요하면 이걸로.
GEMINI_MODEL=gemini-3.8-flash

# --------------------------------------------------------
# 다른 provider 를 쓰려면 AI_PROVIDER=openai 로 바꾸고 아래를 채우면 됩니다.
# 호출하는 쪽 코드(api/recommend.py)는 provider 를 모르기 때문에
# 환경변수만 바꾸면 그대로 동작합니다.
# --------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --------------------------------------------------------
# 데이터 출처 API
# --------------------------------------------------------
# 세 곳 모두 API 키가 필요 없는 공개 엔드포인트입니다.
# 나중에 사람인/원티드 API를 추가할 때만 아래와 같이 키가 필요합니다.
# SARAMIN_API_KEY=...
# WANTED_API_KEY=...